# Eureka credentials (use a long, unique password outside local development)
EUREKA_USERNAME=admin
EUREKA_PASSWORD=replace-with-a-long-random-password

# Host port binding. Keep loopback unless remote access is explicitly required.
EUREKA_BIND_IP=127.0.0.1
EUREKA_HOST_PORT=8761

# API Gateway host binding
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_HOST_PORT=8080

# Optional override; otherwise Compose builds this URL from Eureka credentials above.
# URL-encode special characters in the username/password if using URL basic authentication.
# EUREKA_SERVER_URL=http://admin:replace-with-your-password@eureka-service:8761/eureka/
